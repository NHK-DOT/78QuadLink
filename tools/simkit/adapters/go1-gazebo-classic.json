{
  "schema": 1,
  "id": "go1-gazebo-classic",
  "description": "Go1 example: requires the go1sim shared-memory producer/consumer adapters already built and sourced. Not a stock Gazebo plugin installer.",
  "board_abi": "go1sim-board-v1-8x1024",
  "payload_schema": "go1-12-motors-v2+OBS1+ODO1",
  "backend_cli": "go1relay-flags-v1",
  "board_env": "GO1SIM_STATE_BOARD",
  "clear_env": ["GO1SIM_RELAY_MODE", "GO1SIM_GROUP_MODE", "GO1SIM_SHARED_STATE", "GO1SIM_SHARED_IMU", "GO1SIM_SHARED_ODOM"],
  "profiles": {
    "motor": {"GO1SIM_SHARED_STATE": "1"},
    "motor-imu": {"GO1SIM_SHARED_STATE": "1", "GO1SIM_SHARED_IMU": "1"},
    "motor-imu-odom-experimental": {"GO1SIM_SHARED_STATE": "1", "GO1SIM_SHARED_IMU": "1", "GO1SIM_SHARED_ODOM": "1"}
  }
}
